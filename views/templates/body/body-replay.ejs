<%
  // Writes a value as a JSON string literal for the script below, with < and >
  // as \u escapes, so it is read back as the same text.
  const jsString = (value) => JSON.stringify(String(value)).replace(/</g, '\\u003c').replace(/>/g, '\\u003e');
-%>
