<% 
let values = {
  adv_and: '',
  adv_phr: '',
  adv_not: '',
  type: 'all',
  size: 'all',
  safeSearch: 'on',
  collection: '',
  siteSearch: '',
  maxItems: config.get('image.results.per.page'),
}
// the image search API returns at most 200 images per request
const maxItemsOptions = [...new Set([parseInt(config.get('image.results.per.page')), 50, 100, 200])].sort((a, b) => a - b);

let selectFor = function(key,value){
  return (value == values[key]) ? 'selected' : '';
}
let checkTypeFor = function(type){
  return (values.type == 'all' || values.type.split(',').some(x => x==type)) ? 'checked' : '';
}
if(typeof requestData != 'undefined'){
  Object.keys(values)
    .filter(key => requestData.has(key))
    .forEach(key => {
      values[key] = requestData.get(key);
    });
}

%> 

<!-- starts image advanced search form container -->
<section class="form-container">
    <h3><%= t('advanced-image-search.accessibility.title') %></h3>
<!-- starts pages advanced search -->
<form id="advanced-search-form-images" class="advanced-search-form" action="/image/search" method="GET">
<fieldset>
  <legend><%= t('advanced-image-search.accessibility.legend') %></legend> 
   <!-- With these words -->
   <label for="words"><%- t('advanced-image-search.fieldset.with.label') %></label>
   <input id="words" type="text" name="adv_and" value="<%= values.adv_and %>">
   <small><%= t('advanced-image-search.fieldset.with.example') %></small>
   <!-- With this phrase -->
   <label for="phrase"><%- t('advanced-image-search.fieldset.phrase.label') %></label>
   <input id="phrase" type="text" name="adv_phr" value="<%= values.adv_phr %>">
   <small><%= t('advanced-image-search.fieldset.phrase.example') %></small>
   <!-- Any of these words -->
   <label for="without"><%- t('advanced-image-search.fieldset.without.label') %></label>
   <input id="without" type="text" name="adv_not" value="<%= values.adv_not %>">
   <small><%= t('advanced-image-search.fieldset.without.example') %></small>   
   <!-- Between these dates -->
  <label><%- t('advanced-image-search.fieldset.date.label') %></label> 
  <%- include('../fragments/search-tools-date-slider') %>
   <!-- Formats -->
   <label for="type"><%- t('advanced-image-search.fieldset.format.label') %></label>
   <input type="hidden" id="format-type" name="type">
    <table id="table-format">
      <tbody>
        <tr>
          <td><input type="checkbox" id="format-all" format="all" <%= checkTypeFor('all') %>></td>
          <td><label for="format-all"><strong><%= t('advanced-image-search.fieldset.format.option.all') %></strong></label></td>
      
          <td><input type="checkbox" id="format-gif" format="gif" <%= checkTypeFor('gif') %>></td>
          <td><label for="format-gif">Graphics Interchange Format (.gif)</label></td>
        </tr>
        <tr>
          <td><input type="checkbox" id="format-jpg" format="jpg" <%= checkTypeFor('jpg') %>></td>
          <td><label for="format-jpg">Joint Photographic Experts Group (.jpg)</label></td>
      
          <td><input type="checkbox" id="format-bmp" format="bmp" <%= checkTypeFor('bmp') %>></td>
          <td><label for="format-bmp">Bitmap Image File (.bmp)</label></td>
        </tr>
        <tr>
          <td><input type="checkbox" id="format-png" format="png" <%= checkTypeFor('png') %>></td>
          <td><label for="format-png">Portable Network Graphics (.png)</label></td>
      
          <td><input type="checkbox" id="format-webp" format="webp" <%= checkTypeFor('webp') %>></td>
          <td><label for="format-webp">WEBP (.webp)</label></td>
        </tr>
      </tbody>
    </table>
   <!-- Websites -->
   <label for="website"><%- t('advanced-image-search.fieldset.website.label') %></label>
   <input id="website" type="text" name="siteSearch" value="<%= values.siteSearch %>">
   <small><%= t('advanced-image-search.fieldset.website.example') %></small>

   <!-- Collections -->
   <label for="collection"><%- t('advanced-image-search.fieldset.collection.label') %></label>
   <input id="collection" type="text" name="collection" autocomplete="off" aria-describedby="collection-example" value="<%= values.collection %>">
   <small id="collection-example"><%- t('advanced-image-search.fieldset.collection.example') %></small>

   <!-- words -->
   <label for="image-size"><%- t('advanced-image-search.fieldset.size.label') %></label>
    <select id="image-size" name="size" class="">
     <option value="all" <%= selectFor('size','all') %>><%= t('advanced-image-search.fieldset.size.option.all') %></option>
     <option value="sm" <%= selectFor('size','sm') %>><%= t('advanced-image-search.fieldset.size.option.small') %></option>
     <option value="md" <%= selectFor('size','md') %>><%= t('advanced-image-search.fieldset.size.option.medium') %></option>
     <option value="lg" <%= selectFor('size','lg') %>><%= t('advanced-image-search.fieldset.size.option.large') %></option>
    </select>  
   <!-- words -->
   <label for="safeSearch"><%- t('advanced-image-search.fieldset.safeSearch.label') %></label>
   <select id="safeSearch" name="safeSearch" class="">
    <option value="on" <%= selectFor('safeSearch','on') %>><%= t('advanced-image-search.fieldset.safeSearch.option.remove-explicit') %></option>
    <option value="off" <%= selectFor('safeSearch','off') %>><%= t('advanced-image-search.fieldset.safeSearch.option.all') %></option>
   </select>  

   <!-- Number of results: images -->
   <label for="number-of-results-images"><%- t('advanced-image-search.fieldset.results.label') %></label>
   <select id="number-of-results-images" name="maxItems">
    <% maxItemsOptions.forEach(n => { %>
    <option value="<%= n %>" <%= selectFor('maxItems', n) %>><%= n %></option>
    <% }) %>
   </select>
    
  <!-- starts advanced search navigation -->
  <section class="navigation-tools">
    <h3>Pages advanced search navigation</h3> 
    <button type="submit" class="search-form-advanced-button" value="Advanced Search"><%= t('advanced-image-search.fieldset.search') %> &rarr;</button>
  </section> 
  <!-- ends advanced search navigation -->
</fieldset>      
</form>
<!-- ends pages advanced search -->
</section>
<!-- ends image advanced search form container -->