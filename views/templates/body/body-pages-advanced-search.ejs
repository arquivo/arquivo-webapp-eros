<% 
let values = {
  adv_and: '',
  adv_phr: '',
  adv_not: '',
  type: 'all',
  collection: '',
  siteSearch: '',
  maxItems: '',
  yearBalance: '',
  language: '',
  minLanguageConfidence: '',
}

let checkTypeFor = function(type){
  return (values.type == 'all' || values.type.split(',').some(x => x==type)) ? 'checked' : '';
}
let selectMaxItemsFor = function(n){
  return (n == values.maxItems) ? 'selected' : '';
}
let selectedFor = function(key, value){
  return (value == values[key]) ? 'selected' : '';
}
if(typeof requestData != 'undefined'){
  Object.keys(values)
    .filter(key => requestData.has(key))
    .forEach(key => {
      values[key] = requestData.get(key);
    });
}

%> 

<!-- starts pages advanced search form container -->
<section class="form-container">
    <h3><%= t('advanced-page-search.accessibility.title') %></h3>
<!-- starts pages advanced search -->
<form id="advanced-search-form-pages" class="advanced-search-form" action="/page/search" method="GET">
<fieldset>
  <legend><%= t('advanced-page-search.accessibility.legend') %></legend>
  
  <!-- With these words -->
   <label for="words"><%- t('advanced-page-search.fieldset.with.label') %></label>
   <input id="words" type="text" name="adv_and" value="<%= values.adv_and %>">
   <small><%- t('advanced-page-search.fieldset.with.example') %></small>
   
   <!-- With this phrase -->
   <label for="phrase"><%- t('advanced-page-search.fieldset.phrase.label') %></label>
   <input id="phrase" type="text" name="adv_phr" value="<%= values.adv_phr %>">
   <small><%- t('advanced-page-search.fieldset.phrase.example') %></small>
   
   <!-- Any of these words -->
   <label for="without"><%- t('advanced-page-search.fieldset.without.label') %></label>
   <input id="without" type="text" name="adv_not" value="<%= values.adv_not %>">
   <small><%- t('advanced-page-search.fieldset.without.example') %></small>   
   
  <!-- Between these dates -->
  <label><%- t('advanced-page-search.fieldset.date.label') %></label>
  <!-- starts range slider block --> 
  <%- include('../fragments/search-tools-date-slider') %>
  <!-- ends range slider block -->  

  <!-- Formats -->
  <label for="type"><%- t('advanced-page-search.fieldset.format.label') %></label>
  <input type="hidden" name="type">
  <table id="table-format">
    <tbody>
      <tr>
        <td><input type="checkbox" id="format-all" format="all" <%= checkTypeFor('all') %>></td>
        <td><label for="format-all"><strong><%- t('advanced-page-search.fieldset.format.option.all') %></strong></label></td>

        <td><input type="checkbox" id="format-xls" format="xls" <%= checkTypeFor('xls') %>></td>
        <td><label for="format-xls">Microsoft Excel (.xls)</label></td>
      </tr>
      <tr>
        <td><input type="checkbox" id="format-ppt" format="ppt" <%= checkTypeFor('ppt') %>></td>
        <td><label for="format-ppt">Microsoft PowerPoint (.ppt)</label></td>

        <td><input type="checkbox" id="format-pdf" format="pdf" <%= checkTypeFor('pdf') %>></td>
        <td><label for="format-pdf">Adobe PDF (.pdf)</label></td>
      </tr>
      <tr>
        <td><input type="checkbox" id="format-doc" format="doc" <%= checkTypeFor('doc') %>></td>
        <td><label for="format-doc">Microsoft Word (.doc)</label></td>

        <td><input type="checkbox" id="format-html" format="html" <%= checkTypeFor('html') %>></td>
        <td><label for="format-html">HTML (.htm, .html)</label></td>
      </tr>
    </tbody>
  </table>
  <!-- Website -->
  <label for="website"><%- t('advanced-page-search.fieldset.website.label') %></label>
  <input id="website" type="text" name="siteSearch" value="<%= values.siteSearch %>">
  <small><%- t('advanced-page-search.fieldset.website.example') %></small>

  <!-- Collections -->
  <label for="collection"><%- t('advanced-page-search.fieldset.collection.label') %></label>
  <input id="collection" type="text" name="collection" autocomplete="off" aria-describedby="collection-example" value="<%= values.collection %>">
  <small id="collection-example"><%- t('advanced-page-search.fieldset.collection.example') %></small>

  <!-- Language -->
  <label for="language"><%- t('advanced-page-search.fieldset.language.label') %></label>
  <input id="language" type="text" name="language" maxlength="2" autocomplete="off" aria-describedby="language-example" value="<%= values.language %>">
  <small id="language-example"><%- t('advanced-page-search.fieldset.language.example') %></small>

  <!-- Minimum language confidence -->
  <label for="min-language-confidence"><%- t('advanced-page-search.fieldset.minLanguageConfidence.label') %></label>
  <select id="min-language-confidence" name="minLanguageConfidence" aria-describedby="min-language-confidence-example">
    <option value="" <%= selectedFor('minLanguageConfidence', '') %>><%- t('advanced-page-search.fieldset.minLanguageConfidence.option.default') %></option>
    <% ['HIGH', 'MEDIUM', 'LOW'].forEach(level => { %>
    <option value="<%= level %>" <%= selectedFor('minLanguageConfidence', level) %>><%- t('advanced-page-search.fieldset.minLanguageConfidence.option.' + level.toLowerCase()) %></option>
    <% }) %>
  </select>
  <small id="min-language-confidence-example"><%- t('advanced-page-search.fieldset.minLanguageConfidence.example') %></small>

  <!-- Year balance -->
  <label for="year-balance"><%- t('advanced-page-search.fieldset.yearBalance.label') %></label>
  <select id="year-balance" name="yearBalance" aria-describedby="year-balance-example">
    <option value="" <%= selectedFor('yearBalance', '') %>><%- t('advanced-page-search.fieldset.yearBalance.option.none') %></option>
    <option value="true" <%= selectedFor('yearBalance', 'true') %>><%- t('advanced-page-search.fieldset.yearBalance.option.default') %></option>
    <% const yearBalanceStrengths = ['0.25', '0.5', '0.75', '1'];
       // keeps a strength typed directly in the query (e.g. "yearBalance:0.3") selectable
       if (values.yearBalance != '' && values.yearBalance != 'true' && values.yearBalance != 'false' && !yearBalanceStrengths.includes(values.yearBalance)) {
         yearBalanceStrengths.push(values.yearBalance);
       } %>
    <% yearBalanceStrengths.forEach(strength => { %>
    <option value="<%= strength %>" <%= selectedFor('yearBalance', strength) %>><%= strength %></option>
    <% }) %>
  </select>
  <small id="year-balance-example"><%- t('advanced-page-search.fieldset.yearBalance.example') %></small>

  <!-- Number of results: pages -->
  <label for="number-of-results-pages"><%- t('advanced-page-search.fieldset.results.label') %></label>
  <select id="number-of-results-pages" name="maxItems" class="">
    <option value="10" <%= selectMaxItemsFor(10) %>>10</option>
    <option value="20" <%= selectMaxItemsFor(20) %>>20</option>
    <option value="30" <%= selectMaxItemsFor(30) %>>30</option>
    <option value="50" <%= selectMaxItemsFor(50) %>>50</option>
    <option value="100" <%= selectMaxItemsFor(100) %>>100</option>
    <option value="500" <%= selectMaxItemsFor(500) %>>500</option>
    <option value="1000" <%= selectMaxItemsFor(1000) %>>1000</option>
    <option value="2000" <%= selectMaxItemsFor(2000) %>>2000</option> 
  </select> 

  <!-- starts advanced search navigation -->
  <section class="navigation-tools">
    <h3>Pages advanced search navigation</h3> 
    <button type="submit" class="search-form-advanced-button" value="Advanced Search"><%- t('advanced-page-search.fieldset.search') %> &rarr;</button>
  </section> 
  <!-- ends advanced search navigation -->
   
</fieldset>   
</form>
<!-- ends pages advanced search -->
</section>
<!-- ends pages advanced search form container -->
    
  