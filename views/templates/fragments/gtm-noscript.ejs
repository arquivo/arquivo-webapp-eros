<!-- Google Tag Manager (noscript) -->
<% const gtmAuth = config.get('google.tagmanager.auth'); %>
<% const gtmPreview = config.get('google.tagmanager.preview'); %>
<% const gtmEnvParams = (gtmAuth && gtmPreview) ? `&gtm_auth=${gtmAuth}&gtm_preview=${gtmPreview}&gtm_cookies_win=x` : ''; %>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=<%- config.get('google.tagmanager.id') %><%- gtmEnvParams %>"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
