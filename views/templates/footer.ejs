<%
  // Footer columns, in display order. Each item is a key under
  // `footer.<group>` in translations/footer.yml with `text` and `url`.
  const footerColumns = [
    { id: 'useful-links', group: 'about', items: ['what-is', 'source', 'mooc', 'terms', 'privacy', 'cookies', 'contact'] },
    { id: 'news', group: 'news', items: ['mailing-list', 'channels', 'latest', 'publications', 'exhibitions', 'press', 'dissemination'] },
    { id: 'collaborations', group: 'collaborate', items: ['awards', 'suggest', 'arquivo404', 'memorial', 'archivepagenow', 'citationsaver', 'open-data'] },
    { id: 'help', group: 'help', items: ['page-search', 'image-search', 'crawling', 'access', 'courses', 'catalog', 'sitemap'] },
  ];
%>
<!-- starts white background bottom corner rounded shape -->
<div class="background-bottom-curve"></div>
<!-- ends white background top corner rounded shape -->
<!-- starts footer -->
<footer>
  <!-- starts wrap About, News, Collaborate and Help sections -->
  <section id="important-info">
    <h3 class="visually-hidden"><%= t('footer.about.important-info') %></h3>
    <% footerColumns.forEach(column => { %>
    <section id="<%= column.id %>">
      <h4><%= t(`footer.${column.group}.header`) %></h4>
      <ul>
        <% column.items.forEach(item => { %>
        <li><a href="<%= t(`footer.${column.group}.${item}.url`) %>"><%= t(`footer.${column.group}.${item}.text`) %></a></li>
        <% }) %>
      </ul>
    </section>
    <% }) %>
  </section>
  <!-- ends wrap About, News, Collaborate and Help sections -->

  <!-- starts institutional links -->
  <section id="institutional">
    <h4><%= t('footer.institutional.header.accessibility') %></h4>
    <!-- starts FCT image logo link -->
    <a href="<%= t('footer.institutional.fct-logo.href') %>" target="_blank" title="<%= t('footer.institutional.fct-logo.title') %>"> <img src="<%= t('footer.institutional.fct-logo.src') %>" alt="<%= t('footer.institutional.fct-logo.alt') %>"></a>
    <!-- ends FCT image logo link -->
  </section>
  <!-- ends institutional links -->
</footer>
<!-- ends footer -->
